# Required in CI as the repository secret ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=sk-ant-...

# Pipeline knobs (defaults shown). Anything here changes the eval result, so
# anything here is printed into the report's config fingerprint.
RAG_GENERATOR_MODEL=claude-opus-5
RAG_JUDGE_MODEL=claude-opus-5
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=4
RAG_CHUNK_CHARS=700
RAG_CHUNK_OVERLAP=120
RAG_PROMPT_VARIANT=grounded
RAG_EFFORT=low

# Eval controls
EVAL_REPEATS=3
JUDGE_EFFORT=low
JUDGE_MAX_WORKERS=4
GEN_WORKERS=4

# Set to 1 to run retrieval-only, no API calls. Unit tests and the perf
# warm-up use this; the quality gate refuses to trust it.
RAG_OFFLINE=0
