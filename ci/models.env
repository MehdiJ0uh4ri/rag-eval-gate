# Pinned model identity for the whole pipeline.
#
# This file is the analogue of `ci/upstream.env` in the other labs: exactly one
# place couples the pipeline to something that moves outside our repo. A model
# bump shifts every metric, so it lands as its own PR that also re-baselines --
# see docs/runbook.md "Rotating the judge".
RAG_GENERATOR_MODEL=claude-opus-5
RAG_JUDGE_MODEL=claude-opus-5
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Judge/generator depth. `low` effort is deliberate: the judge scores one claim
# against one passage at a time, and higher effort costs ~3x for no measurable
# agreement gain on this dataset (docs/thresholds.md).
RAG_EFFORT=low
JUDGE_EFFORT=low

# Judge passes per run. 3 is the smallest odd number that lets a median absorb
# a single flaky verdict.
EVAL_REPEATS=3
